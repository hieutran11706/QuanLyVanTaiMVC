@model IEnumerable<QuanLyVanTaiMVC.Models.OrderListItem>
@{ ViewBag.Title = "Quản lý đơn hàng"; }
<div class="page-heading"><div><h1>Quản lý đơn hàng</h1><p>Tra cứu đơn theo mã đơn, khách hàng và trạng thái vận chuyển.</p></div></div>
@if (ViewBag.Error != null) { <div class="alert danger">@ViewBag.Error</div> }
<form method="get" class="filter-bar">
    <input name="keyword" value="@ViewBag.Keyword" placeholder="Nhập mã đơn hoặc tên khách hàng..." />
    <select name="status">
        <option value="">Tất cả trạng thái</option>
        <option value="MOI_TAO" @(ViewBag.Status as string == "MOI_TAO" ? "selected" : "")>Mới tạo</option>
        <option value="DANG_XU_LY" @(ViewBag.Status as string == "DANG_XU_LY" ? "selected" : "")>Đang xử lý</option>
        <option value="DANG_VAN_CHUYEN" @(ViewBag.Status as string == "DANG_VAN_CHUYEN" ? "selected" : "")>Đang vận chuyển</option>
        <option value="DA_GIAO" @(ViewBag.Status as string == "DA_GIAO" ? "selected" : "")>Đã giao</option>
    </select>
    <button class="btn primary" type="submit">Tìm kiếm</button>
</form>
<div class="panel table-panel">
    <div class="table-head"><div><h2>Danh sách đơn hàng</h2><p>@Model.Count() đơn hàng tìm thấy</p></div></div>
    <div class="table-wrap"><table>
        <thead><tr><th>MÃ ĐƠN</th><th>KHÁCH HÀNG</th><th>NGÀY ĐẶT</th><th>TUYẾN ĐƯỜNG</th><th>BIỂN SỐ</th><th>TRẠNG THÁI</th><th>TỔNG TIỀN</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td><b>#@item.MaDh</b></td><td>@item.TenKh</td><td>@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Tuyen</td><td>@item.BienSo</td>
                <td><span class="pill @(item.TrangThai == "DA_GIAO" ? "green-pill" : item.TrangThai == "DANG_VAN_CHUYEN" ? "orange-pill" : "blue-pill")">@item.TrangThai</span></td>
                <td class="amount">@item.TongTien.ToString("N0") đ</td>
                <td><a class="table-action" href="@Url.Action("Tracking", new { id = item.MaDh })">Chi tiết →</a></td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="8" class="empty">Không có đơn hàng phù hợp.</td></tr> }
        </tbody>
    </table></div>
</div>
